# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local docker-compose Postgres. If running the server outside Docker (e.g. `npm run dev`,
# `prisma migrate dev`), point this at localhost:5433 instead of the "postgres" service
# hostname/port — 5433 is docker-compose's host-side port mapping, chosen to avoid colliding
# with a locally installed Postgres that may already be using 5432.
DATABASE_URL=postgresql://flaky:flaky@localhost:5433/flaky_test_detector

# GitHub personal access token (classic or fine-grained) with read access to Actions
# workflow runs/jobs/artifacts for the repo(s) you want to ingest.
GITHUB_TOKEN=

# Slack incoming webhook URL used to notify on quarantine state transitions. Optional:
# leave blank to disable Slack notifications.
SLACK_WEBHOOK_URL=

# Shared bearer token the dashboard sends on every API request. Generate any random
# string, e.g. `openssl rand -hex 32`.
DASHBOARD_ACCESS_TOKEN=
